{
  "name": "@deepseek-ai/dsh-tool-mes-pull",
  "description": "Pull one MES order's data by its key into the shared review pool; read-only, never pushes",
  "version": "0.2.2-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiJiehui777/deepseek-harness.git",
    "directory": "packages/interaction/tool-mes-pull"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "queries/*.sql",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "cordis",
    "mes",
    "connector"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0"
  },
  "icon": "./icon.svg",
  "locale": {
    "zh-CN": "./locale/zh.json",
    "en-US": "./locale/en.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-tool-postgres-connector": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-tool-postgres-connector": "workspace:*",
    "@deepseek-ai/dsh-mes-pipeline-workdb": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tool-executor-native": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mes-pipeline-workdb": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
